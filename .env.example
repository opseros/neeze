# Postgres connection (managed Postgres in an Indian region in production)
DATABASE_URL=postgresql://neeze:neeze@127.0.0.1:5432/neeze
# Long random string: openssl rand -base64 32
PAYLOAD_SECRET=change-me
# Separate secret for customer OTP session cookies
SESSION_SECRET=change-me-too
# Production: https://neeze.opseros.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# OTP delivery: "console" (dev only) or "msg91" (after TRAI DLT registration)
OTP_PROVIDER=console
# Dev only: return the OTP in the API response so you can test without SMS. Ignored when NODE_ENV=production.
OTP_DEV_ECHO=true
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Cloudflare R2 for uploaded photos (leave R2_BUCKET empty in local dev to store in ./media)
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public custom domain connected to the bucket. Production: https://neeze-media.opseros.com
R2_PUBLIC_URL=
