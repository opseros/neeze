# Postgres connection (managed Postgres in an Indian region in production)
DATABASE_URL=postgresql://neeze:neeze@127.0.0.1:5432/neeze
# Long random string: openssl rand -base64 32
PAYLOAD_SECRET=change-me
# Separate secret for customer OTP session cookies
SESSION_SECRET=change-me-too
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# OTP delivery: "console" (dev only) or "msg91" (after TRAI DLT registration)
OTP_PROVIDER=console
# Dev only: return the OTP in the API response so you can test without SMS. Ignored when NODE_ENV=production.
OTP_DEV_ECHO=true
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
