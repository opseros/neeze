# Postgres connection (managed Postgres in an Indian region in production)
DATABASE_URL=postgresql://neeze:neeze@127.0.0.1:5432/neeze
# Long random string: openssl rand -base64 32
PAYLOAD_SECRET=change-me
# Separate secret for customer OTP session cookies
SESSION_SECRET=change-me-too
# Production: https://neeze.opseros.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sign-in (leave a provider's ID empty to hide its button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# Email sign-in codes (dev without a key: emails print to the server console)
RESEND_API_KEY=
EMAIL_FROM=neeze@opseros.com
# Mobile number check: on whenever OTP_PROVIDER is set; set to "off" to save numbers without a code
# PHONE_VERIFICATION=off

# Codes for the mobile number check: "whatsapp" (no DLT needed), "msg91" (SMS, after TRAI DLT registration) or "console" (dev only)
OTP_PROVIDER=console
# Optional backup channel if the main one fails, e.g. OTP_FALLBACK=msg91 once DLT is approved
OTP_FALLBACK=
# Dev only: return the OTP in the API response so you can test without SMS. Ignored when NODE_ENV=production.
OTP_DEV_ECHO=true
# WhatsApp Cloud API (Meta): approved AUTHENTICATION template with a copy-code button
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=neeze_login_code
WHATSAPP_OTP_TEMPLATE_LANG=en
# SMS via MSG91 (after DLT)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Cloudflare R2 for uploaded photos (leave R2_BUCKET empty in local dev to store in ./media)
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public custom domain connected to the bucket. Production: https://neeze-media.opseros.com
R2_PUBLIC_URL=
